<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SONORAPORT WORLD CLOCK"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/masterLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="PHOENIX // MASTER CLOCK"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/masterClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="--:--:--"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/masterDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading Phoenix time..."
            android:textSize="16sp" />

        <TextView
            android:id="@+id/zeroHourLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="ZERO HOUR"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/zeroHourCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="-- DAYS  --:--:--"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/worldClockLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="WORLD CLOCK NETWORK"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/worldClockContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/swarmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="RC3444 // INITIALIZING"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
