{
  "version": 1,
  "purpose": "Concurrent global bank registry discovery and per-institution technical SKIM",
  "status": "CONFIGURED_NOT_EXECUTED",
  "frameworkCandidates": [
    "LangGraph",
    "CrewAI",
    "OpenAI Agents SDK",
    "Microsoft Agent Framework"
  ],
  "existingSupervisor": "agent-system/research-fleet-supervisor.mjs",
  "workerLimit": 8,
  "coverage": "All countries and territories with banking regulators; no fixed small bank list",
  "stages": [
    "discover official regulator registers",
    "enumerate each individual licensed bank",
    "deduplicate with regulator identifiers",
    "locate official developer documentation",
    "extract endpoints auth OAuth mTLS SDK webhook sandbox production permissions",
    "classify payment rails and blockchain integration",
    "cross-check official sources",
    "persist evidence with timestamp and access status"
  ],
  "outputSchema": {
    "country": "ISO 3166-1 alpha-2",
    "bankName": "legal name",
    "regulator": "official regulator",
    "licenseId": "if published",
    "apiDocs": "official URL if published",
    "authMethods": [],
    "sdk": [],
    "webhooks": [],
    "sandbox": "verified/unverified/unavailable",
    "blockchain": "verified/unverified/not applicable",
    "sourceUrls": [],
    "verifiedAt": "ISO timestamp",
    "connectionStatus": "UNVERIFIED"
  },
  "security": {
    "noCredentialHarvesting": true,
    "noSecretStorage": true,
    "noUnauthorizedBankAccess": true
  },
  "sourceFrameworks": [
    "https://langchain-ai.github.io/langgraph/",
    "https://www.langchain.com/resources/ai-agent-frameworks"
  ],
  "sourceBanking": [
    "https://www.bis.org/about/organisation/members"
  ],
  "execution": {
    "runner": "agent-system/research-fleet-supervisor.mjs",
    "queue": "agent-system/supabase-job-store.mjs",
    "jobRunner": "agent-system/run-queued-official-doc-research.mjs",
    "requires": [
      "SONORAPORT_RESEARCH_STAGING_APPROVED=true",
      "SONORAPORT_SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "TINYFISH_API_KEY",
      "approved 144-agent roster",
      "validated 19-lane manifest",
      "populated Supabase research queue"
    ],
    "command": "node agent-system/research-fleet-supervisor.mjs <roster.json> <manifest.json> --execute-bounded-research",
    "defaultWorkers": 4,
    "maximumWorkers": 8,
    "maxClaimsPerInvocation": 18,
    "continuousExecution": false,
    "executionVerified": false
  }
}
